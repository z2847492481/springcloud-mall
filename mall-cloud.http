####################################################################
# mall-cloud 接口测试集合
# IDEA 中点击每个请求左侧的绿色箭头即可执行
# 约定：后续每新增/调整一个接口，都在这里补一条
####################################################################

### 网关健康检查
GET http://localhost:8080/actuator/health

### 用户服务健康检查（直连）
GET http://localhost:8081/actuator/health

### 查询用户（直连用户服务）
GET http://localhost:8081/user/1

### 查询用户（经网关路由，需 token）
GET http://localhost:8080/api/user/1
Authorization: Bearer {{token}}

### 用户登录（直连用户服务）
POST http://localhost:8081/user/login
Content-Type: application/json

{
  "username": "demo",
  "password": "123456"
}

### 用户登录（经网关路由）
POST http://localhost:8080/api/user/login
Content-Type: application/json

{
  "username": "demo",
  "password": "123456"
}

> {%
client.global.set("token", response.body.data.token);
%}

### 未携带 token 访问受保护接口（预期 401）
GET http://localhost:8080/api/order/TEST-401

### 跨域预检（预期返回 Access-Control-Allow-Origin）
OPTIONS http://localhost:8080/api/user/1
Origin: http://localhost:3000
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

### 商品服务健康检查（直连）
GET http://localhost:8082/actuator/health

### 查询商品（直连商品服务）
GET http://localhost:8082/product/1

### 商品列表（直连商品服务）
GET http://localhost:8082/product/list?pageNum=1&pageSize=10

### 商品列表按关键字搜索
GET http://localhost:8082/product/list?keyword=%E9%94%AE%E7%9B%98&pageNum=1&pageSize=10

### 查询商品（经网关路由）
GET http://localhost:8080/api/product/1

### 商品列表（经网关路由）
GET http://localhost:8080/api/product/list?pageNum=1&pageSize=10

### 库存服务健康检查（直连）
GET http://localhost:8083/actuator/health

### 预占库存（直连库存服务）
POST http://localhost:8083/stock/lock
Content-Type: application/json

{
  "orderNo": "TEST-001",
  "productId": 1,
  "quantity": 2
}

### 释放预占库存（直连库存服务）
POST http://localhost:8083/stock/unlock
Content-Type: application/json

{
  "orderNo": "TEST-001",
  "productId": 1,
  "quantity": 2
}

### 预占库存（经网关路由，需 token）
POST http://localhost:8080/api/stock/lock
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderNo": "TEST-001",
  "productId": 1,
  "quantity": 2
}

### 释放预占库存（经网关路由，需 token）
POST http://localhost:8080/api/stock/unlock
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderNo": "TEST-001",
  "productId": 1,
  "quantity": 2
}

### 订单服务健康检查（直连）
GET http://localhost:8084/actuator/health

### 创建订单（直连订单服务）
POST http://localhost:8084/order/create
Content-Type: application/json

{
  "userId": 1,
  "items": [
    {
      "productId": 1,
      "quantity": 2
    }
  ]
}

> {%
client.global.set("orderNo", response.body.data.orderNo);
%}

### 查询订单（直连订单服务）
GET http://localhost:8084/order/{{orderNo}}

### 模拟支付（直连订单服务）
POST http://localhost:8084/order/{{orderNo}}/pay

### 订单发货（直连订单服务，模拟 WMS 内部调用）
POST http://localhost:8084/order/{{orderNo}}/ship

### 仓库确认出库（直连 WMS）
POST http://localhost:8085/wms/outbound/{{orderNo}}

### 创建订单（经网关路由，需 token）
POST http://localhost:8080/api/order/create
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": 1,
  "items": [
    {
      "productId": 1,
      "quantity": 2
    }
  ]
}

### 查询订单（经网关路由，需 token）
GET http://localhost:8080/api/order/{{orderNo}}
Authorization: Bearer {{token}}

### 模拟支付（经网关路由，需 token）
POST http://localhost:8080/api/order/{{orderNo}}/pay
Authorization: Bearer {{token}}

### 订单发货（经网关路由，需 token）
POST http://localhost:8080/api/order/{{orderNo}}/ship
Authorization: Bearer {{token}}

### 仓库确认出库（经网关路由，需 token）
POST http://localhost:8080/api/wms/outbound/{{orderNo}}
Authorization: Bearer {{token}}

### Nacos：查询 dev 命名空间下的共享配置
GET http://localhost:8848/nacos/v1/cs/configs?dataId=mall-common.yaml&group=DEFAULT_GROUP&tenant=dev

### Nacos：查询 dev 命名空间下的服务列表
GET http://localhost:8848/nacos/v1/ns/service/list?pageNo=1&pageSize=20&namespaceId=dev

### Nacos：查询 mall-user 实例
GET http://localhost:8848/nacos/v1/ns/instance/list?serviceName=mall-user&namespaceId=dev

### Nacos：查询 mall-product 实例
GET http://localhost:8848/nacos/v1/ns/instance/list?serviceName=mall-product&namespaceId=dev

### Nacos：查询 mall-stock 实例
GET http://localhost:8848/nacos/v1/ns/instance/list?serviceName=mall-stock&namespaceId=dev

### Nacos：查询 mall-order 实例
GET http://localhost:8848/nacos/v1/ns/instance/list?serviceName=mall-order&namespaceId=dev

### Nacos：查询 mall-wms 实例
GET http://localhost:8848/nacos/v1/ns/instance/list?serviceName=mall-wms&namespaceId=dev
